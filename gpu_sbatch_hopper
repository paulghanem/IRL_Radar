#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH --gpus=v100-32:1
#SBATCH -t 2-00:00:00

#SBATCH --output=hopper_%x_seed%a_%j.out
#SBATCH --error=hopper_%x_seed%a_%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=ghanem.p@northeastern.edu

echo "=== Hopper RIRL Experiment on V100-32 GPU ==="
echo "Method: ${METHOD}"
echo "Seed: ${SEED}"
echo "Node: $SLURM_NODELIST"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo ""

# -----------------------------
# Load modules and activate environment
# -----------------------------
module load anaconda3/2024.10-1
module load cuda/12.4.0
echo "✓ CUDA 12.4.0 module loaded"

conda activate rirl
echo "✓ Conda environment activated"
echo ""

# -----------------------------
# Configure CUDA library paths for JAX
# -----------------------------
echo "Configuring CUDA library paths..."
NVIDIA_SITE_PACKAGES=$(python -c "import sys, os; paths = [p for p in sys.path if 'site-packages' in p and os.path.exists(os.path.join(p, 'nvidia'))]; print(paths[0] if paths else '')")

if [ -n "$NVIDIA_SITE_PACKAGES" ]; then
    echo "Found nvidia in site-packages: $NVIDIA_SITE_PACKAGES/nvidia"
    NVIDIA_LIB_PATHS=$(find "$NVIDIA_SITE_PACKAGES/nvidia" -maxdepth 2 -name 'lib' -type d | tr '\n' ':')
    export LD_LIBRARY_PATH="$NVIDIA_LIB_PATHS:$LD_LIBRARY_PATH"
    echo "✓ Added nvidia library paths to LD_LIBRARY_PATH"
else
    echo "WARNING: Could not find nvidia in site-packages"
fi

# Configure JAX for GPU
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_PLATFORMS=cuda
echo "✓ JAX configured for GPU"
echo ""

# -----------------------------
# Build command based on method
# -----------------------------
BASE_CMD="python main_lax.py \
    --gym_env=Hopper \
    --num_traj=500 \
    --horizon=50 \
    --N_steps=1000 \
    --N_steps_expert=1000 \
    --rirl_iterations=1000 \
    --reward_fn_updates=15 \
    --seed=${SEED} \
    --lr=1e-4 \
    --lambda_=0.01 \
    --Q=1e-4 \
    --P=1e-2 \
    --hidden_dim=16 \
    --no-save_images"

# Add method-specific flags
case ${METHOD} in
    "UB")
        CMD="${BASE_CMD} --UB"
        ;;
    "gail")
        CMD="${BASE_CMD} --gail"
        ;;
    "airl")
        CMD="${BASE_CMD} --airl"
        ;;
    "gcl")
        CMD="${BASE_CMD}"
        ;;
    "sqil")
        CMD="${BASE_CMD} --sqil"
        ;;
    *)
        echo "ERROR: Unknown method ${METHOD}"
        exit 1
        ;;
esac

# -----------------------------
# Run Hopper RIRL experiment
# -----------------------------
echo "Starting experiment..."
echo "Command: ${CMD}"
echo "=========================================="
echo ""

${CMD}

echo ""
echo "=========================================="
echo "Experiment complete"
echo "Method: ${METHOD}, Seed: ${SEED}"
